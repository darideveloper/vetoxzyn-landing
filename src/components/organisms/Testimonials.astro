---
import Eyebrow from "@/components/atoms/Eyebrow.astro"
import TestimonialCard from "@/components/molecules/TestimonialCard.astro"
import { TESTIMONIALS } from "@/data/testimonials"

// Square placeholder dividers (swap URLs only when brand art lands).
const DIVIDERS = [
  "https://picsum.photos/id/237/600/600",
  "https://picsum.photos/id/1025/600/600",
]
---

<section id="section-3" aria-labelledby="testimonials-heading" class="relative overflow-hidden py-xl">
  <div aria-hidden="true" class="bg-fluid-shape absolute inset-0 -z-10 bg-[#f3f3f7]/50 backdrop-blur-md"></div>
  <div aria-hidden="true" class="absolute -top-40 -right-40 -z-10 h-96 w-96 rounded-full bg-brand-orange/10 blur-3xl"></div>
  <div aria-hidden="true" class="absolute -bottom-40 -left-40 -z-10 h-[500px] w-[500px] rounded-full bg-brand-pink/10 blur-3xl"></div>
  <div class="max-w-max-width mx-auto px-margin-mobile md:px-margin-desktop">
    <div class="mb-xl text-center">
      <Eyebrow>EVIDENCIA CLÍNICA</Eyebrow>
      <h2 id="testimonials-heading" class="mt-4 font-display-lg text-[32px] leading-[1.25] font-bold text-on-surface md:text-[48px] md:leading-[1.2]">
        Lo que dicen los veterinarios
      </h2>
      <p class="mx-auto mt-4 max-w-2xl font-body-lg text-body-lg text-on-surface-variant">
        Experiencias reales documentadas sobre la integración de matrices bioseguras en la práctica clínica diaria.
      </p>
    </div>
    <div class="mt-12 grid grid-cols-1 gap-gutter md:grid-cols-[1fr_5vw_1fr_5vw_1fr]">
      {TESTIMONIALS.map((t, i) => (
        <>
          <TestimonialCard quote={t.quote} name={t.name} role={t.role} accent={t.accent} avatar={t.avatar} />
          {i < TESTIMONIALS.length - 1 && (
            <div aria-hidden="true" class="h-24 w-full overflow-hidden rounded-xl md:h-[60%] md:self-center">
              <img src={DIVIDERS[i]} alt="" width="600" height="600" loading="lazy" class="h-full w-full object-cover" />
            </div>
          )}
        </>
      ))}
    </div>
  </div>
</section>

<style>
  .bg-fluid-shape {
    clip-path: polygon(0 0, 100% 5%, 100% 100%, 0 95%);
  }
</style>
