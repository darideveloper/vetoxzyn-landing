---
import SectionHeader from "@/components/molecules/SectionHeader.astro"
import FeatureList from "@/components/molecules/FeatureList.astro"
import MediaWithTags from "@/components/molecules/MediaWithTags.astro"
---

<section
  id="desafios"
  aria-labelledby="challenges-heading"
  class="relative overflow-hidden bg-surface-ice pt-xl pb-xl font-body-md text-on-surface"
>
  <div class="relative z-10 mx-auto grid w-full max-w-max-width grid-cols-1 items-center gap-lg px-gutter lg:grid-cols-12 lg:gap-0">
    <div class="relative z-10 rounded-[24px] border border-surface-container-highest bg-on-primary p-8 shadow-card md:p-12 lg:col-span-7">
      <SectionHeader
        eyebrow="Dr. Resultados"
        subtitle="Soluciones biomiméticas diseñadas para superar los desafíos diarios en bioseguridad e higiene veterinaria, garantizando resultados predecibles y seguros."
        subtitleClass="mt-sm max-w-2xl font-body-lg text-body-lg text-on-surface-variant"
      >
        <h2 id="challenges-heading" slot="title" class="mt-md font-display-lg-mobile text-4xl leading-tight md:text-5xl">
          Transciende los Obstáculos Clínicos
        </h2>
      </SectionHeader>
      <FeatureList />
    </div>
    <div class="relative z-20 mt-lg lg:col-span-5 lg:mt-0 lg:-ml-16">
      <MediaWithTags />
    </div>
  </div>
</section>
