---
import { getImage } from "astro:assets"
import type { ImageMetadata } from "astro"
import SectionHeader from "@/components/molecules/SectionHeader.astro"
import ProductPanel from "@/components/molecules/ProductPanel.astro"
import FormulaStrip from "@/components/molecules/FormulaStrip.astro"
import { ProductGallery } from "@/components/molecules/ProductGallery"
import { SECTION_IDS } from "@/data/section-ids"
import type { ProductsData } from "@/lib/avatars"

interface Props {
  data: ProductsData
  slug: string
}
const { data, slug } = Astro.props

// Gallery sources are auto-sourced per avatar: drop files in
// src/content/avatars/es/<slug>/gallery/ (png/webp/jpg/jpeg/avif). Empty
// folder → no slides → the strip is skipped. Sorted by path for stable order.
const galleryModules = import.meta.glob<{ default: ImageMetadata }>(
  "@/content/avatars/es/*/gallery/*.{png,webp,jpg,jpeg,avif}",
  { eager: true },
)

const GALLERY_SOURCES = Object.entries(galleryModules)
  .filter(([path]) => path.includes(`/es/${slug}/gallery/`))
  .sort(([a], [b]) => a.localeCompare(b))
  .map(([path, mod]) => {
    const file = path.split("/").pop() ?? path
    const base = file.replace(/\.(png|jpe?g|avif|webp)$/i, "")
    const alt = base.replace(/[_-]+/g, " ").replace(/\s+/g, " ").trim()
    const presentationMatch = base.match(/(\d+)\s*(ml|l)/i)
    const presentation = presentationMatch
      ? `${presentationMatch[1]} ${presentationMatch[2].toLowerCase() === "ml" ? "ml" : "L"}`
      : undefined
    return { src: mod.default, alt, presentation }
  })

const GALLERY_WIDTHS = [256, 320, 400]
const GALLERY_SIZES = "(max-width: 639px) 82vw, (max-width: 1023px) 46vw, (max-width: 1279px) 31vw, 24vw"

const gallerySlides = await Promise.all(
  GALLERY_SOURCES.map(async ({ src, alt, presentation }) => {
    const [avif, webp] = await Promise.all([
      getImage({ src, widths: GALLERY_WIDTHS, format: "avif" }),
      getImage({ src, widths: GALLERY_WIDTHS, format: "webp" }),
    ])
    return {
      avifSrcSet: avif.srcSet.attribute,
      webpSrcSet: webp.srcSet.attribute,
      fallbackSrc: webp.src,
      alt,
      presentation,
    }
  }),
)

const lines = data.lines
const single = lines.length === 1
---

<section
  id={SECTION_IDS.productos}
  aria-labelledby="products-heading"
  class="js-products-section scroll-mt-20 font-body-md text-on-surface"
  transition:animate="none"
>
  <div class="js-products-header js-products-reveal js-reveal mx-auto max-w-max-width px-gutter pt-xl pb-lg text-center">
    <SectionHeader
      align="center"
      id="products-heading"
      title={data.title}
      subtitle={data.subtitle}
      subtitleClass="mx-auto mt-sm max-w-[28rem] font-body-md text-body-md text-on-surface-variant"
    />
  </div>

  {single ? (
    <div class="grid w-full grid-cols-1">
      <div class="min-w-0">
        <ProductPanel
          line={lines[0].line}
          title={lines[0].title}
          tagline={lines[0].tagline}
          image={lines[0].image}
          imageAlt={lines[0].imageAlt}
          fullWidth
        />
      </div>
      {gallerySlides.length > 0 && (
        <div class="relative z-20 min-w-0">
          <div class="relative z-10 mx-auto w-full max-w-5xl px-gutter py-lg">
            <ProductGallery slides={gallerySlides} sizes={GALLERY_SIZES} client:visible />
          </div>
        </div>
      )}
    </div>
  ) : (
    <div class="grid w-full grid-cols-1 lg:grid-cols-2 lg:grid-rows-[100vh_auto]">
      <div class="min-w-0 lg:col-start-1 lg:row-start-1 lg:row-end-3">
        <ProductPanel
          line={lines[0].line}
          title={lines[0].title}
          tagline={lines[0].tagline}
          image={lines[0].image}
          imageAlt={lines[0].imageAlt}
        />
      </div>
      {/* client:visible island — no js-reveal/js-products-panel hooks, so the
          GSAP timeline never selects it and autoplay never fights scroll. */}
      {gallerySlides.length > 0 && (
        <div class="relative z-20 min-w-0 lg:col-span-2 lg:col-start-1 lg:row-start-2">
          <div
            aria-hidden="true"
            class="pointer-events-none absolute inset-0 z-0 hidden backdrop-blur-md [mask-image:linear-gradient(to_right,transparent,black_30%,black_70%,transparent)] lg:block"
          ></div>
          <div class="relative z-10 mx-auto w-full max-w-5xl px-gutter py-lg lg:pt-md lg:pb-xl">
            <ProductGallery slides={gallerySlides} sizes={GALLERY_SIZES} client:visible />
          </div>
        </div>
      )}
      <div class="min-w-0 lg:col-start-2 lg:row-start-1 lg:row-end-3">
        <ProductPanel
          line={lines[1].line}
          title={lines[1].title}
          tagline={lines[1].tagline}
          image={lines[1].image}
          imageAlt={lines[1].imageAlt}
        />
      </div>
    </div>
  )}

  <FormulaStrip />
</section>

<script>
  import { gsap, ScrollTrigger } from "@/lib/gsap"

  let mm: ReturnType<typeof gsap.matchMedia> | undefined

  const init = () => {
    const section = document.querySelector(".js-products-section")
    if (!section) return

    mm?.revert()
    mm = gsap.matchMedia()

    mm.add("(prefers-reduced-motion: no-preference)", () => {
      gsap.set(section.querySelectorAll(".js-products-reveal"), {
        autoAlpha: 1,
        force3D: true,
      })

      const tl = gsap.timeline({
        scrollTrigger: {
          trigger: section,
          start: "top 75%",
          toggleActions: "play none none none",
        },
      })

      tl.from(section.querySelector(".js-products-header"), {
        autoAlpha: 0,
        y: 40,
        duration: 1.2,
        ease: "power4.out",
      }).from(
        section.querySelectorAll(".js-products-panel"),
        {
          autoAlpha: 0,
          y: 60,
          duration: 1.2,
          stagger: 0.2,
          ease: "expo.out",
        },
        "-=0.8",
      )
    })

    mm.add("(prefers-reduced-motion: reduce)", () => {
      const targets = section.querySelectorAll(".js-products-reveal")

      if (ScrollTrigger.isInViewport(section as Element)) {
        gsap.set(targets, { autoAlpha: 1 })
        return
      }

      gsap.set(targets, { autoAlpha: 0 })

      ScrollTrigger.create({
        trigger: section,
        start: "top 75%",
        once: true,
        onEnter: () => {
          gsap.to(targets, {
            autoAlpha: 1,
            duration: 0.8,
            stagger: 0.1,
          })
        },
      })
    })
  }

  document.addEventListener("astro:after-swap", () => mm?.revert())
  document.addEventListener("astro:page-load", init)
  init()
</script>
