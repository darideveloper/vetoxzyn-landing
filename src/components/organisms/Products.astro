---
import SectionHeader from "@/components/molecules/SectionHeader.astro"
import ProductPanel from "@/components/molecules/ProductPanel.astro"
import FormulaStrip from "@/components/molecules/FormulaStrip.astro"
---

<section
  id="section-4"
  aria-labelledby="products-heading"
  class="font-body-md text-on-surface"
>
  <div class="mx-auto max-w-max-width px-gutter pt-xl pb-lg text-center">
    <SectionHeader
      align="center"
      id="products-heading"
      title="Líneas para tu clínica y quirófano"
      subtitle="Soluciones de bioseguridad oxidativa avanzada para entornos veterinarios exigentes."
      subtitleClass="mx-auto mt-sm max-w-[28rem] font-body-md text-body-md text-on-surface-variant"
    />
  </div>

  <div class="flex w-full flex-col lg:flex-row">
    <ProductPanel tone="light" />
    <ProductPanel tone="dark" />
  </div>

  <FormulaStrip />
</section>
