---
import { Image } from "astro:assets"
import Badge from "@/components/atoms/Badge.astro"
import { Button } from "@/components/atoms/Button.tsx"
import topicoImg from "@/assets/products/topico-512.webp"
import instalacionesImg from "@/assets/products/instalaciones-512.webp"

const pill = "No requiere enjuague"
---

<section
  id="section-3"
  aria-labelledby="products-heading"
  class="bg-surface-ice font-body-md text-on-surface"
>
  <div class="mx-auto max-w-max-width px-gutter pt-xl pb-lg text-center">
    <h2 id="products-heading" class="font-display-lg-mobile text-display-lg-mobile text-on-surface">
      Líneas para tu clínica y quirófano
    </h2>
    <p class="mx-auto mt-sm max-w-md font-body-md text-body-md text-on-surface-variant">
      Soluciones de bioseguridad oxidativa avanzada para entornos veterinarios exigentes.
    </p>
  </div>

  <div class="flex w-full flex-col lg:flex-row">
    <!-- Panel 1: Tópico (light) -->
    <article aria-labelledby="products-topico-title" class="group relative flex min-h-[100vh] w-full items-center justify-center overflow-hidden border-r border-surface-container-highest bg-white lg:w-1/2">
      <div class="absolute top-1/2 left-4 z-30 hidden -translate-y-1/2 sm:flex writing-vertical rotate-180">
        <Badge icon="water_drop" class="font-bold tracking-widest uppercase">{pill}</Badge>
      </div>
      <div class="absolute inset-0 z-0">
        <Image
          src={topicoImg}
          widths={[384, 512]}
          sizes="(max-width: 1024px) 100vw, 50vw"
          loading="lazy"
          alt="Entorno clínico luminoso de la línea Tópico"
          class="image-pan h-full w-full object-cover opacity-60 mix-blend-luminosity transition-all duration-1000 group-hover:mix-blend-normal"
        />
        <div aria-hidden="true" class="absolute inset-0 bg-gradient-to-br from-white/80 via-white/40 to-transparent"></div>
      </div>
      <div class="relative z-10 flex h-full w-full flex-col justify-between p-lg">
        <div class="mt-xl mb-8">
          <h3 id="products-topico-title" class="mb-2 font-display-lg-mobile text-display-lg-mobile font-bold tracking-tighter text-on-surface">
            Tópico
          </h3>
          <p class="max-w-sm font-body-lg text-body-lg font-bold text-brand-orange">
            Higiene tópica de piel, mucosas y áreas post-quirúrgicas.
          </p>
        </div>
        <div class="hud-panel relative mt-auto mb-md w-full max-w-md overflow-hidden rounded-2xl p-md shadow-2xl">
          <div class="absolute top-0 left-0 h-full w-1 bg-brand-orange" aria-hidden="true"></div>
          <dl class="grid grid-cols-2 gap-x-4 gap-y-6 font-body-md text-on-surface">
            <div>
              <dt class="mb-1 text-[10px] font-bold tracking-widest text-on-surface-variant uppercase">Concentración</dt>
              <dd class="font-semibold">100 ppm <span class="text-xs opacity-60">(0.010%)</span></dd>
            </div>
            <div>
              <dt class="mb-1 text-[10px] font-bold tracking-widest text-on-surface-variant uppercase">pH</dt>
              <dd class="font-semibold">6.0–7.5 <span class="text-xs opacity-60">(neutro)</span></dd>
            </div>
            <div>
              <dt class="mb-1 text-[10px] font-bold tracking-widest text-on-surface-variant uppercase">ORP</dt>
              <dd class="font-bold text-brand-orange text-xl">&gt; 850 mV</dd>
            </div>
            <div>
              <dt class="mb-1 text-[10px] font-bold tracking-widest text-on-surface-variant uppercase">Toxicidad</dt>
              <dd class="font-semibold text-tertiary">Grado 0 <span class="text-xs opacity-60">(no irritante)</span></dd>
            </div>
            <div class="col-span-2">
              <dt class="mb-1 text-[10px] font-bold tracking-widest text-on-surface-variant uppercase">Presentaciones</dt>
              <dd class="font-semibold">30ml a 950ml</dd>
            </div>
          </dl>
          <Button variant="product" tone="light" href="#section-5">
            Ver ficha técnica
            <span class="material-symbols-outlined text-[16px]" aria-hidden="true">arrow_forward</span>
          </Button>
        </div>
      </div>
    </article>

    <!-- Panel 2: Instalaciones (dark) -->
    <article aria-labelledby="products-instalaciones-title" class="group relative flex min-h-[100vh] w-full items-center justify-center overflow-hidden bg-inverse-surface lg:w-1/2">
      <div class="absolute top-1/2 right-4 z-30 hidden -translate-y-1/2 sm:flex writing-vertical">
        <Badge icon="cleaning_services" class="font-bold tracking-widest uppercase">{pill}</Badge>
      </div>
      <div class="absolute inset-0 z-0">
        <Image
          src={instalacionesImg}
          widths={[384, 512]}
          sizes="(max-width: 1024px) 100vw, 50vw"
          loading="lazy"
          alt="Entorno clínico de la línea Instalaciones"
          class="image-pan h-full w-full object-cover opacity-40 mix-blend-luminosity transition-all duration-1000 group-hover:mix-blend-normal"
        />
        <div aria-hidden="true" class="absolute inset-0 bg-gradient-to-tl from-inverse-surface/90 via-inverse-surface/60 to-transparent"></div>
      </div>
      <div class="relative z-10 flex h-full w-full flex-col items-end justify-between p-lg text-right">
        <div class="mt-xl mb-8">
          <h3 id="products-instalaciones-title" class="mb-2 font-display-lg-mobile text-display-lg-mobile font-bold tracking-tighter text-white">
            Instala-<br />ciones
          </h3>
          <p class="ml-auto max-w-sm font-body-lg text-body-lg font-bold text-secondary-container">
            Superficies, instrumental, áreas de consulta y quirófano, agua.
          </p>
        </div>
        <div class="hud-panel-dark relative mt-auto mb-md w-full max-w-md overflow-hidden rounded-2xl p-md text-left text-gray-200 shadow-2xl">
          <div class="absolute top-0 right-0 h-full w-1 bg-secondary-container" aria-hidden="true"></div>
          <dl class="grid grid-cols-2 gap-x-4 gap-y-6 font-body-md">
            <div>
              <dt class="mb-1 text-[10px] font-bold tracking-widest text-gray-400 uppercase">Concentración</dt>
              <dd class="font-semibold text-white">500 ppm <span class="text-xs opacity-60">(0.050%)</span></dd>
            </div>
            <div>
              <dt class="mb-1 text-[10px] font-bold tracking-widest text-gray-400 uppercase">pH</dt>
              <dd class="font-semibold text-white">6.0–7.5 <span class="text-xs opacity-60">(neutro)</span></dd>
            </div>
            <div>
              <dt class="mb-1 text-[10px] font-bold tracking-widest text-gray-400 uppercase">ORP</dt>
              <dd class="font-bold text-secondary-container text-xl">&gt; 900 mV</dd>
            </div>
            <div>
              <dt class="mb-1 text-[10px] font-bold tracking-widest text-gray-400 uppercase">Toxicidad</dt>
              <dd class="font-semibold text-tertiary-fixed">Grado 0 <span class="text-xs opacity-60">(no irritante)</span></dd>
            </div>
            <div class="col-span-2">
              <dt class="mb-1 text-[10px] font-bold tracking-widest text-gray-400 uppercase">Presentaciones</dt>
              <dd class="font-semibold text-white">1L · 4L · 20L</dd>
            </div>
          </dl>
          <Button variant="product" tone="dark" href="#section-5">
            Ver ficha técnica
            <span class="material-symbols-outlined text-[16px]" aria-hidden="true">arrow_forward</span>
          </Button>
        </div>
      </div>
    </article>
  </div>

  <div class="border-t border-white/10 bg-black/80 p-4 backdrop-blur-md">
    <p class="mx-auto flex max-w-5xl flex-col items-center justify-center gap-2 font-caption text-caption tracking-wide text-gray-300 uppercase md:flex-row md:gap-8">
      <span><strong class="text-white">Fórmula:</strong> H₂O + NaCl + electrólisis = HOCl</span>
      <span class="hidden text-gray-600 md:inline" aria-hidden="true">|</span>
      <span><strong class="text-white">Mecanismo:</strong> Lisis por oxidación en segundos</span>
      <span class="hidden text-gray-600 md:inline" aria-hidden="true">|</span>
      <span class="font-bold text-brand-orange">Sin residuos persistentes</span>
    </p>
  </div>
</section>
