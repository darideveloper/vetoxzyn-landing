---
import { ContactForm } from "@/components/molecules/ContactForm.tsx"
import SectionHeader from "@/components/molecules/SectionHeader.astro"
import ContactBackdrop from "@/components/molecules/ContactBackdrop.astro"
import FaqAccordion from "@/components/molecules/FaqAccordion.astro"
import ContactMedia from "@/components/molecules/ContactMedia.astro"
import DisclaimerNote from "@/components/molecules/DisclaimerNote.astro"
import { SECTION_IDS } from "@/data/section-ids"
---

<section
  id={SECTION_IDS.contacto}
  aria-labelledby="contact-heading"
  class="relative scroll-mt-20 overflow-x-clip bg-surface-ice font-body-md text-on-surface"
>
  <!-- Immersive background (Stitch 05-contact-form, section-scoped) -->
  <ContactBackdrop />

  <div class="relative z-10 mx-auto flex w-full max-w-max-width flex-col items-center px-gutter py-20">
    <!-- Header (flattened in-flow from the Stitch lg:absolute overlay) -->
    <div class="mb-12 w-full text-left">
      <SectionHeader
        subtitle="Inicie el protocolo de integración biológica. Conecte su infraestructura con la precisión clínica de nuestra matriz oxidativa."
        subtitleClass="font-body-lg text-body-lg mt-6 max-w-[28rem] text-on-surface-variant"
      >
        <h2 id="contact-heading" slot="title" class="text-display-lg-mobile md:text-display-lg max-w-3xl leading-tight text-on-surface">
          ¿Listo para elevar la <span class="bg-gradient-to-r from-brand-orange to-brand-pink bg-clip-text text-transparent">bioseguridad</span> de tu clínica?
        </h2>
      </SectionHeader>
    </div>

    <!-- Section grid: stacked on mobile, static 12-col grid at lg (no overlap) -->
    <div class="grid w-full grid-cols-1 gap-8 lg:grid-cols-12 lg:gap-10">
      <!-- Contact form (right column, full height) -->
      <div class="w-full lg:col-span-7 lg:col-start-6 lg:row-span-3 lg:row-start-1">
        <ContactForm client:load />
      </div>

      <!-- FAQ layer (overlapping) -->
      <FaqAccordion class="lg:col-span-5 lg:col-start-1 lg:row-start-1" />

      <!-- Image layer -->
      <ContactMedia class="lg:col-span-5 lg:col-start-1 lg:row-start-2" />
      <!-- Disclaimer layer -->
      <DisclaimerNote class="lg:col-span-5 lg:col-start-1 lg:row-start-3" />
    </div>
  </div>
</section>
