---
import SectionHeader from "@/components/molecules/SectionHeader.astro"
import HeroBullets from "@/components/molecules/HeroBullets.astro"
import HeroActions from "@/components/molecules/HeroActions.astro"
import HeroMediaCard from "@/components/molecules/HeroMediaCard.astro"
---

<section
  aria-labelledby="hero-heading"
  class="relative flex min-h-[90vh] items-center justify-center overflow-hidden bg-surface-ice pt-xl pb-xl font-body-md text-on-surface"
>
  <div aria-hidden="true" class="blob-bg top-[-10%] left-[-10%] h-[60vw] w-[60vw] rounded-full bg-secondary-fixed/40"></div>
  <div aria-hidden="true" class="blob-bg right-[-10%] bottom-[-10%] h-[50vw] w-[50vw] rounded-full bg-primary-fixed-dim/30" style="animation-delay: -5s;"></div>
  <div class="relative z-10 mx-auto grid w-full max-w-max-width grid-cols-1 items-center gap-lg px-gutter lg:grid-cols-12">
    <div class="z-20 flex flex-col items-center gap-md text-center md:items-start md:text-left lg:col-span-7">
      <SectionHeader
        eyebrow="Tecnología oxidativa para práctica veterinaria"
        level="h1"
        id="hero-heading"
        title="vetoxzyn®: bioseguridad avanzada para tu clínica."
        subtitle="Integra a tu clínica una tecnología de limpieza externa especializada que protege el tejido vivo y asegura la integridad de tu instrumental quirúrgico."
        subtitleClass="mx-auto max-w-2xl font-body-lg text-body-lg text-on-surface-variant md:mx-0"
      />
      <HeroBullets />
      <HeroActions />
    </div>
    <div class="relative z-10 mt-lg flex justify-center lg:col-span-5 lg:mt-0 lg:justify-end">
      <HeroMediaCard />
    </div>
  </div>
</section>
