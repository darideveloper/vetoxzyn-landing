---
import ResponsiveImage from "../atoms/ResponsiveImage.astro"
import heroImg from "@/assets/hero/hero-clinica.webp"
---

<div class="js-hero-media js-hero-reveal js-reveal glass-panel shadow-ambient tilt-float relative aspect-[4/5] w-full max-w-[28rem] overflow-hidden rounded-xl border-l-[4px] border-l-brand-pink">
  <ResponsiveImage
    src={heroImg}
    widths={[480, 800, 1024, 1280]}
    sizes="(max-width: 1024px) 100vw, 448px"
    eager
    alt="Instrumental quirúrgico veterinario sobre una bandeja estéril"
    class="h-full w-full object-cover"
  />
</div>
