---
import FeatureRow from "./FeatureRow.astro"

interface Feature {
  title: string
  challenge: string
  solution: string
}
interface Props {
  features: Feature[]
}
const { features } = Astro.props

// Icons are global code constants (no per-avatar icon customization).
const ICONS = ["shield", "water_drop", "eco"]
---

<div class="mt-lg flex flex-col gap-8">
  {features.map((f, i) => (
    <FeatureRow icon={ICONS[i] ?? ICONS[ICONS.length - 1]} title={f.title} challenge={f.challenge} solution={f.solution} />
  ))}
</div>
