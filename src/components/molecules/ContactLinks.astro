---
import { EMAIL, PHONES } from "@/data/site-config"
import NavLink from "../atoms/NavLink.astro"

// Shared phone + email link pair (no wrapper — multiple roots).
interface Props {
  emailClass?: string
}
const { emailClass = "" } = Astro.props
---

<NavLink href={PHONES.main.href}>{PHONES.main.formatted}</NavLink>
<NavLink href={EMAIL.href} class={emailClass}>{EMAIL.address}</NavLink>
