---
import Badge from "../atoms/Badge.astro"
import { Button } from "@/components/atoms/Button"
import ResponsiveImage from "../atoms/ResponsiveImage.astro"
import SpecGrid from "./SpecGrid.astro"
import type { ImageMetadata } from "astro"
import { PRODUCTS, type ProductLine } from "@/data/products"
import { SECTION_IDS } from "@/data/section-ids"

// Pill icons are global code constants (no per-avatar icon customization).
const PILL_ICON: Record<ProductLine, string> = {
  topico: "water_drop",
  instalaciones: "cleaning_services",
}

interface Props {
  line: ProductLine
  title: string
  tagline: string
  image: ImageMetadata
  imageAlt: string
  fullWidth?: boolean
}
const { line, title, tagline, image, imageAlt, fullWidth = false } = Astro.props

const product = PRODUCTS[line]
const dark = product.tone === "dark"
const headingId = dark ? "products-instalaciones-title" : "products-topico-title"
const pillIcon = PILL_ICON[line]
---

<article
  aria-labelledby={headingId}
  class:list={[
    "js-products-panel js-products-reveal js-reveal group relative flex min-h-[100vh] w-full items-center justify-center overflow-hidden lg:h-full lg:items-start",
    dark ? "bg-inverse-surface" : `border-r border-surface-container-highest bg-on-primary`,
    fullWidth && "lg:min-h-[100vh]",
  ]}
>
  <div class="absolute inset-0 z-0">
    <ResponsiveImage
      src={image}
      widths={[768, 1280, 1536, 2048]}
      sizes="(max-width: 1024px) 100vw, 50vw"
      alt={imageAlt}
      class:list={[
        "image-pan h-full w-full object-cover mix-blend-luminosity transition-all duration-[var(--duration-hover)] ease-[var(--ease-hover)] group-hover:mix-blend-normal",
        dark ? "opacity-40" : "opacity-60",
      ]}
    />
    <div
      aria-hidden="true"
      class:list={[
        "absolute inset-0",
        dark
          ? "bg-gradient-to-tl from-inverse-surface/90 via-inverse-surface/60 to-transparent"
          : "bg-gradient-to-br from-on-primary/80 via-on-primary/40 to-transparent",
      ]}
    ></div>
  </div>
  <div
    class:list={[
      "relative z-10 flex h-full w-full flex-col justify-between p-lg lg:h-auto lg:min-h-[100vh]",
      dark && "items-end text-right",
    ]}
  >
    <div class="mt-xl mb-8">
      <h3
        id={headingId}
        class:list={[
          "mb-2 font-display-lg-mobile text-display-lg-mobile font-bold tracking-tighter",
          dark ? "text-on-primary" : "text-on-surface",
        ]}
      >
        {title}
      </h3>
      <p
        class:list={[
          "max-w-[24rem] font-body-lg text-body-lg font-bold",
          dark ? "ml-auto text-secondary-container" : "text-brand-orange",
        ]}
      >
        {tagline}
      </p>
    </div>
    <div
      class:list={[
        "relative mt-auto mb-md w-full max-w-[28rem] overflow-hidden rounded-2xl p-md shadow-2xl",
        dark ? "hud-panel-dark text-left text-on-primary/80 sm:mr-md" : "hud-panel sm:ml-md",
      ]}
    >
      <div
        class:list={[
          "absolute top-0 h-full w-1",
          dark ? "right-0 bg-secondary-container" : "left-0 bg-brand-orange",
        ]}
        aria-hidden="true"
      ></div>
      <SpecGrid tone={product.tone} items={product.specs} />
      <Button variant="product" tone={product.tone} href={`#${SECTION_IDS.contactoFormulario}`} className="mt-md">
        Revisar esta configuración
        <span class="material-symbols-outlined text-[16px]" aria-hidden="true">arrow_forward</span>
      </Button>
    </div>
    <div
      class:list={[
        "absolute bottom-lg z-30 hidden sm:flex writing-vertical",
        dark ? "right-4" : "left-4 rotate-180",
      ]}
    >
      <Badge icon={pillIcon} class="font-bold tracking-widest uppercase">{product.pill}</Badge>
    </div>
  </div>
</article>
