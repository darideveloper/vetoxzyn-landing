---
import SpecItem from "../atoms/SpecItem.astro"

export interface Spec {
  term: string
  value: string
  note?: string
  valueClass?: string
  wide?: boolean
}

interface Props {
  tone?: "light" | "dark"
  items: Spec[]
}
const { tone = "light", items } = Astro.props
---

<dl class:list={["grid grid-cols-2 gap-x-4 gap-y-6 font-body-md", tone === "light" && "text-on-surface"]}>
  {items.map((item) => (
    <SpecItem term={item.term} tone={tone} wide={item.wide} valueClass={item.valueClass}>
      {item.value}{item.note && (
        <>
          {" "}
          <span class="text-xs opacity-60">{item.note}</span>
        </>
      )}
    </SpecItem>
  ))}
</dl>
