---
import Eyebrow from "../atoms/Eyebrow.astro"

// Shared section heading: optional eyebrow + title + subtitle.
// Canonical title core (single source of truth — identical Montserrat
// 32px → 64px visuals for h1 and h2; `level` switches the tag only).
// `titleClass` is extras-only (spacing/layout) and merges after the core.
// `id` anchors string titles. The `title` slot is reserved for inline
// markup a string cannot express (contact gradient) and MUST reuse
// SECTION_TITLE_CORE (import this const at the call site).
export const SECTION_TITLE_CORE =
  "font-display-lg-mobile text-display-lg-mobile md:font-display-lg md:text-display-lg text-on-surface"
// `level` sets the heading tag for string titles; the `title` slot bypasses it
// (preserves inline markup, e.g. contact gradient).
interface Props {
  eyebrow?: string
  title?: string
  titleClass?: string
  level?: "h1" | "h2"
  id?: string
  subtitle?: string
  subtitleClass?: string
  align?: "left" | "center"
  class?: string
}
const {
  eyebrow,
  title,
  titleClass = "",
  level = "h2",
  id,
  subtitle,
  subtitleClass = "",
  align = "left",
  class: cls = "",
} = Astro.props
const Tag = level === "h1" ? "h1" : "h2"
const titleCls = [SECTION_TITLE_CORE, titleClass].filter(Boolean).join(" ")
const hasTitleSlot = Astro.slots.has("title")
const hasSubtitleSlot = Astro.slots.has("subtitle")
---

<div class:list={[align === "center" && "text-center", cls]}>
  {eyebrow && <Eyebrow>{eyebrow}</Eyebrow>}
  {title ? (
    <Tag id={id} class={titleCls}>{title}</Tag>
  ) : (
    hasTitleSlot && <slot name="title" />
  )}
  {subtitle ? (
    <p class={subtitleClass}>{subtitle}</p>
  ) : (
    hasSubtitleSlot && <slot name="subtitle" />
  )}
</div>
