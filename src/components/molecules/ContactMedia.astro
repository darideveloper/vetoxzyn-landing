---
import type { ImageMetadata } from "astro"
import ResponsiveImage from "../atoms/ResponsiveImage.astro"

interface Props {
  image: ImageMetadata
  imageAlt: string
  class?: string
}
const { image, imageAlt, class: cls = "" } = Astro.props
---

<div class:list={["hover-subtle aspect-[16/9] w-full overflow-hidden rounded-3xl border-4 border-on-primary/80 shadow-2xl rotate-[-1deg] lg:-rotate-3", cls]}>
  <ResponsiveImage
    src={image}
    widths={[480, 768, 1024]}
    sizes="(max-width: 1024px) 100vw, 450px"
    alt={imageAlt}
    class="h-full w-full object-cover"
  />
</div>
