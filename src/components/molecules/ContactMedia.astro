---
import ResponsiveImage from "../atoms/ResponsiveImage.astro"
import contactImg from "@/assets/contact/contact-clinica.webp"

interface Props {
  class?: string
}
const { class: cls = "" } = Astro.props
---

<div class:list={["hover-subtle aspect-[16/9] w-full overflow-hidden rounded-3xl border-4 border-on-primary/80 shadow-2xl rotate-[-1deg] lg:-rotate-3", cls]}>
  <ResponsiveImage
    src={contactImg}
    widths={[480, 768, 1024]}
    sizes="(max-width: 1024px) 100vw, 450px"
    alt="Clínica veterinaria de alta tecnología con superficies de vidrio e instrumental metálico bajo luz blanca"
    class="h-full w-full object-cover"
  />
</div>
