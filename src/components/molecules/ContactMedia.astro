---
import ResponsiveImage from "../atoms/ResponsiveImage.astro"
import contactImg from "@/assets/contact/contact-clinica-512.webp"

interface Props {
  class?: string
}
const { class: cls = "" } = Astro.props
---

<div class:list={["w-full overflow-hidden rounded-3xl border-4 border-on-primary/80 shadow-2xl rotate-[-1deg] lg:-rotate-3", cls]}>
  <ResponsiveImage
    src={contactImg}
    sizes="(max-width: 1024px) 100vw, 480px"
    alt="Clínica veterinaria de alta tecnología con superficies de vidrio e instrumental metálico bajo luz blanca"
    class="h-auto w-full"
  />
</div>
