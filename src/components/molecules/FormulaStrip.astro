---
import { FORMULA_BANNER } from "@/data/products"
---

<div class="js-products-strip js-products-reveal js-reveal border-t border-on-primary/10 bg-inverse-surface/80 p-4 backdrop-blur-md">
  <p class="mx-auto flex max-w-5xl flex-col items-center justify-center gap-2 font-caption text-caption tracking-wide text-on-primary/70 uppercase md:flex-row md:gap-8">
    <span><strong class="text-on-primary">Fórmula:</strong> {FORMULA_BANNER.formula.replace(/^Fórmula:\s*/, "")}</span>
    <span class="hidden text-on-primary/30 md:inline" aria-hidden="true">|</span>
    <span><strong class="text-on-primary">Mecanismo:</strong> {FORMULA_BANNER.mechanism.replace(/^Mecanismo:\s*/, "")}</span>
    <span class="hidden text-on-primary/30 md:inline" aria-hidden="true">|</span>
    <span class="font-bold text-brand-orange">{FORMULA_BANNER.noResidue}</span>
  </p>
</div>
