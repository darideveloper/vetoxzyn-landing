---
import Icon from "../atoms/Icon.astro"
import FaqItem from "./FaqItem.astro"
import { SECTION_IDS } from "@/data/section-ids"

interface Faq {
  question: string
  answer: string
}
interface Props {
  faqs: Faq[]
  class?: string
}
const { faqs, class: cls = "" } = Astro.props
---

<div data-faq id={SECTION_IDS.contactoFaq} class:list={["glass-panel-heavy w-full rounded-3xl p-8 shadow-2xl backdrop-blur-md rotate-[1deg] lg:rotate-[3deg]", cls]}>
  <div class="mb-8 flex items-center gap-4">
    <Icon name="info" variant="circle" tone="pink" size="lg" filled />
    <h3 class="font-body-lg text-body-lg m-0 leading-none font-bold text-on-surface">Preguntas frecuentes</h3>
  </div>
  <div class="space-y-3">
    {faqs.map((f) => (
      <FaqItem q={f.question} a={f.answer} />
    ))}
  </div>
</div>

<script>
  document.querySelectorAll("[data-faq]").forEach((root) => {
    root.querySelectorAll("details").forEach((detail) => {
      detail.addEventListener("toggle", () => {
        if (detail.open) {
          root.querySelectorAll("details").forEach((other) => {
            if (other !== detail && other.open) {
              other.open = false;
            }
          });
        }
      });
    });
  });
</script>
