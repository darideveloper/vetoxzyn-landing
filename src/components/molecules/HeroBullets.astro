---
import Icon from "../atoms/Icon.astro"

const bullets = [
  { icon: "local_hospital", label: "Para clínica" },
  { icon: "workspaces", label: "Áreas de trabajo" },
  { icon: "cleaning_services", label: "Procesos de higiene" },
]
---

<ul class="js-hero-bullets js-hero-reveal js-reveal mt-sm flex w-fit flex-col gap-sm">
  {bullets.map((b) => (
    <li class="flex items-center gap-md">
      <Icon name={b.icon} filled />
      <span class="text-body-md text-on-surface-variant">{b.label}</span>
    </li>
  ))}
</ul>
