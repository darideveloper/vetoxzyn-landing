---
import { Button } from "@/components/atoms/Button"
import { SECTION_IDS } from "@/data/section-ids"
---

<div class="js-hero-actions js-hero-reveal js-reveal mt-lg flex flex-wrap justify-center gap-md md:justify-start">
  <Button variant="primary" size="md" href={`#${SECTION_IDS.contactoFormulario}`}>
    ★ Orientarme para mi clínica
    <span class="material-symbols-outlined" aria-hidden="true">arrow_forward</span>
  </Button>
  <Button variant="secondary" size="md" href={`#${SECTION_IDS.productos}`}>
    Ver cómo se integra
  </Button>
</div>
