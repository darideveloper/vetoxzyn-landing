---
import { Button } from "@/components/atoms/Button"
import { SECTION_IDS } from "@/data/section-ids"
---

<div class="mt-lg flex flex-wrap justify-center gap-md md:justify-start">
  <Button variant="primary" size="md" href={`#${SECTION_IDS.contacto}`}>
    Cotiza para tu clínica
    <span class="material-symbols-outlined" aria-hidden="true">arrow_forward</span>
  </Button>
  <Button variant="secondary" size="md" href={`#${SECTION_IDS.productos}`}>
    Ver línea Tópico
  </Button>
</div>
