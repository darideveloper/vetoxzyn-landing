---
import { Image } from "astro:assets"

interface Props {
  src: ImageMetadata
  alt?: string
  widths?: number[]
  sizes?: string
  class?: string
}
const { src, alt = "", widths = [400, 800], sizes = "80px", class: cls = "" } = Astro.props
---

<Image
  src={src}
  widths={widths}
  sizes={sizes}
  alt={alt}
  loading="lazy"
  decoding="async"
  class:list={["hover-subtle h-full w-full object-cover", cls]}
/>
