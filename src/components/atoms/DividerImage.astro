---
import { Picture } from "astro:assets"

interface Props {
  src: ImageMetadata
  alt?: string
  widths?: number[]
  sizes?: string
  class?: string
}
const {
  src,
  alt = "",
  widths = [200, 400],
  sizes = "(max-width: 768px) 100vw, 5vw",
  class: cls = "",
} = Astro.props
---

<Picture
  src={src}
  formats={["avif", "webp"]}
  fallbackFormat="webp"
  widths={widths}
  sizes={sizes}
  alt={alt}
  loading="lazy"
  decoding="async"
  class:list={["h-full w-full object-cover", cls]}
  pictureAttributes={{ class: "hover-subtle h-full w-full" }}
/>
