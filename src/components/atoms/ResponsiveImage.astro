---
import { Picture } from "astro:assets"

interface Props {
  src: ImageMetadata
  alt: string
  sizes: string
  widths?: number[]
  eager?: boolean
  class?: string | string[]
}
const { src, alt, sizes, widths, eager = false, class: cls = "" } = Astro.props
---

{eager ? (
  <Picture
    src={src}
    formats={["avif", "webp"]}
    fallbackFormat="webp"
    widths={widths ?? [480, 800, 1024, 1280]}
    sizes={sizes}
    loading="eager"
    fetchpriority="high"
    decoding="async"
    alt={alt}
    class:list={[cls]}
  />
) : (
  <Picture
    src={src}
    formats={["avif", "webp"]}
    fallbackFormat="webp"
    widths={widths ?? [480, 800, 1024, 1200]}
    sizes={sizes}
    loading="lazy"
    decoding="async"
    alt={alt}
    class:list={[cls]}
  />
)}
