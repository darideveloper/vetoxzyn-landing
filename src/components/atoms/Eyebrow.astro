---
 // E2 standard: orange-tint pill, science icon, uppercase label.
interface Props {
  icon?: string
  class?: string
}
const { icon = "science", class: cls = "" } = Astro.props
---

<span class:list={["inline-flex items-center gap-2 rounded-full bg-brand-orange/10 px-4 py-1.5", cls]}>
  <span class="material-symbols-outlined filled text-sm text-brand-orange">{icon}</span>
  <span class="text-xs font-bold uppercase tracking-widest text-brand-orange"><slot /></span>
</span>

<style>
  .filled { font-variation-settings: 'FILL' 1; }
</style>
