---
// Plain <img> avatar — external URLs only (Unsplash), never astro:assets.
interface Props {
  src: string
  alt: string
  class?: string
}
const { src, alt, class: cls = "" } = Astro.props
---

<img
  src={src}
  alt={alt}
  width="96"
  height="96"
  loading="lazy"
  class:list={["hover-subtle h-24 w-24 rounded-full border-4 border-white object-cover shadow-lg", cls]}
/>
