---
import Layout from "@/layouts/Layout.astro"
import PageSEO from "@/components/seo/PageSEO.astro"
import { ContactForm } from "@/components/molecules/ContactForm.tsx"
---

<Layout>
  <PageSEO currentPage="home" slot="seo" />
  <section class="mx-auto max-w-5xl px-4 py-16 text-center">
    <h1>Vetoxzyn — landing headline goes here</h1>
    <p class="mx-auto mt-4 max-w-2xl">One-paragraph value proposition. Replace with real copy.</p>
    <p class="mt-6">
      <a href="/contact" class="rounded-2xl bg-brand-500 px-5 py-2.5 text-white">Get in touch</a>
    </p>
  </section>
  <section class="mx-auto max-w-5xl px-4 py-12">
    <h2>Why Vetoxzyn</h2>
    <ul class="mt-4 grid gap-4 sm:grid-cols-3">
      <li class="rounded-xl border p-4">Benefit one</li>
      <li class="rounded-xl border p-4">Benefit two</li>
      <li class="rounded-xl border p-4">Benefit three</li>
    </ul>
  </section>
  <section class="mx-auto max-w-5xl px-4 py-12" aria-labelledby="contact-heading">
    <h2 id="contact-heading">Contact us</h2>
    <ContactForm client:load />
  </section>
</Layout>
