---
import Layout from "@/layouts/Layout.astro"
import PageSEO from "@/components/seo/PageSEO.astro"
import Hero from "@/components/organisms/Hero.astro"
import Challenges from "@/components/organisms/Challenges.astro"
import Products from "@/components/organisms/Products.astro"
import { ContactForm } from "@/components/molecules/ContactForm.tsx"
---

<Layout lang="es">
  <PageSEO currentPage="home" slot="seo" />
  <Hero />
  <Challenges />
  <Products />
  <section id="section-5" class="mx-auto max-w-5xl px-4 py-12" aria-labelledby="contact-heading">
    <h2 id="contact-heading">Contact us</h2>
    <ContactForm client:load />
  </section>
</Layout>
