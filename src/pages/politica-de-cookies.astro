---
import Layout from "@/layouts/Layout.astro"
import PageSEO from "@/components/seo/PageSEO.astro"
import Markdown from "@/components/atoms/Markdown.astro"
import cookiesPolicy from "@/data/cookies-policy.md?raw"
---

<Layout lang="es">
  <PageSEO
    currentPage="cookies"
    title="Política de cookies"
    description="Conoce qué almacenamiento y cookies utiliza el canal comercial de vetoxzyn® y cómo deshabilitarlos."
    slot="seo"
  />
  <section class="mx-auto w-full max-w-4xl px-4 py-16 sm:px-6 lg:px-8">
    <Markdown content={cookiesPolicy} />
  </section>
</Layout>
