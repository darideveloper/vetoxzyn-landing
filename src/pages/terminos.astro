---
import Layout from "@/layouts/Layout.astro"
import PageSEO from "@/components/seo/PageSEO.astro"
import Markdown from "@/components/atoms/Markdown.astro"
import terms from "@/data/terms.md?raw"
---

<Layout lang="es">
  <PageSEO
    currentPage="terms"
    title="Términos de uso del canal comercial"
    description="Condiciones de uso del canal de contacto y cotización de vetoxzyn®."
    slot="seo"
  />
  <section class="mx-auto w-full max-w-4xl px-4 py-16 sm:px-6 lg:px-8">
    <Markdown content={terms} />
  </section>
</Layout>
