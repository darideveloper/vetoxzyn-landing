---
import Layout from "@/layouts/Layout.astro"
import PageSEO from "@/components/seo/PageSEO.astro"
import Card from "@/components/atoms/Card.astro"
import Badge from "@/components/atoms/Badge.astro"
import Eyebrow from "@/components/atoms/Eyebrow.astro"
import Icon from "@/components/atoms/Icon.astro"
import { DesignSystemDemos } from "./_demos.tsx"
---

<Layout lang="es">
  <PageSEO currentPage="design-system" slot="seo" title="Design System — Vetoxzyn" description="Living showcase of standardized global atoms and variants." />
  <div class="mx-auto max-w-5xl px-4 py-16 flex flex-col gap-16">
    <header>
      <Eyebrow>Design System</Eyebrow>
      <h1 class="mt-4 text-4xl font-bold">Global components + variants</h1>
      <p class="mt-2 text-lg text-black/60">Living showcase of every standardized atom. Dropped variants (B1, B5, E1, E3, P3, I2, C2, C3) are intentionally absent.</p>
    </header>

    <section id="button" class="flex flex-col gap-4">
      <h2 class="text-2xl font-bold">Button <span class="text-base font-normal text-black/50">primary · secondary · product × light/dark · sizes md/sm</span></h2>
      <p class="text-sm text-black/50">Interactive sizes + product tones live below in § Form demo (React island).</p>
    </section>

    <section id="eyebrow" class="flex flex-col gap-4">
      <h2 class="text-2xl font-bold">Eyebrow <span class="text-base font-normal text-black/50">E2 standard</span></h2>
      <div class="flex flex-wrap gap-3">
        <Eyebrow>Dr. Resultados</Eyebrow>
        <Eyebrow>Tecnología oxidativa para práctica veterinaria</Eyebrow>
        <Eyebrow>Evidencia clínica</Eyebrow>
      </div>
    </section>

    <section id="badge" class="flex flex-col gap-4">
      <h2 class="text-2xl font-bold">Badge <span class="text-base font-normal text-black/50">feature · tag dark/primary/light</span></h2>
      <div class="flex flex-wrap items-center gap-2">
        <Badge icon="water_drop">pH neutro</Badge>
        <Badge icon="hub">HOCl biomimético</Badge>
        <Badge icon="health_and_safety">Grado 0 de irritación</Badge>
        <Badge icon="shield">Cero corrosión</Badge>
        <Badge icon="eco">Sin residuos</Badge>
        <Badge>Clinical Grade</Badge>
      </div>
      <div class="flex flex-wrap items-center gap-2">
        <Badge variant="tag" tone="dark">Clinical Grade</Badge>
        <Badge variant="tag" tone="primary">99.9% Biosecurity</Badge>
        <Badge variant="tag" tone="light" icon="verified">99.9% Pure</Badge>
      </div>
    </section>

    <section id="icon" class="flex flex-col gap-4">
      <h2 class="text-2xl font-bold">Icon <span class="text-base font-normal text-black/50">circle md/lg × tones · bare</span></h2>
      <div class="flex flex-wrap items-center gap-3">
        <Icon name="water_drop" />
        <Icon name="shield" tone="orange" />
        <Icon name="verified" tone="primary" filled />
        <Icon name="eco" tone="green" />
        <Icon name="info" size="lg" filled />
      </div>
      <div class="flex flex-wrap items-center gap-4">
        <Icon name="format_quote" variant="bare" tone="orange" filled class="text-4xl opacity-50" />
        <Icon name="format_quote" variant="bare" filled class="text-4xl opacity-50" />
        <Icon name="format_quote" variant="bare" tone="green" filled class="text-4xl opacity-50" />
        <Icon name="add_circle" variant="bare" tone="orange" />
        <Icon name="warning" variant="bare" tone="orange" filled />
        <Icon name="verified" variant="bare" tone="primary" />
      </div>
    </section>

    <section id="card" class="flex flex-col gap-4">
      <h2 class="text-2xl font-bold">Card <span class="text-base font-normal text-black/50">C1 glass</span></h2>
      <div class="grid gap-4 md:grid-cols-3">
        <Card>
          <p class="italic">«Como es una solución a base de HOCl, no corroe nada del instrumental…»</p>
          <p class="mt-4 text-sm font-bold">Dr. Alejandro Méndez</p>
          <p class="text-xs text-black/60">Clínica Veterinaria San José · CDMX</p>
        </Card>
        <Card>
          <p class="italic">«La limpieza tópica post-quirúrgica mantiene condiciones higiénicas óptimas…»</p>
          <p class="mt-4 text-sm font-bold">Dra. Sofía Ramírez</p>
          <p class="text-xs text-black/60">Hospital Veterinario Central · Guadalajara</p>
        </Card>
        <Card>
          <p class="italic">«Integramos vetoxzyn® a nuestros protocolos sanitarios…»</p>
          <p class="mt-4 text-sm font-bold">MVZ Carlos Valdés</p>
          <p class="text-xs text-black/60">Clínica BioPet · Monterrey</p>
        </Card>
      </div>
    </section>

    <section id="form" class="flex flex-col gap-4">
      <h2 class="text-2xl font-bold">Input · Textarea · Checkbox · Button <span class="text-base font-normal text-black/50">F1 · F3 · F2 · B2/B3/B4 (React island, demo store)</span></h2>
      <DesignSystemDemos client:load />
    </section>
  </div>
</Layout>
