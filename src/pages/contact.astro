---
import Layout from "@/layouts/Layout.astro"
import PageSEO from "@/components/seo/PageSEO.astro"
import ContactSection from "@/components/organisms/ContactSection.astro"
import NavLink from "@/components/atoms/NavLink.astro"
import { EMAIL, PHONES } from "@/data/site-config"
---

<Layout>
  <PageSEO currentPage="contact" title="Contacto" slot="seo" />
  <section class="mx-auto max-w-5xl px-4 py-16">
    <h1>Contacto</h1>
    <p class="mt-4">
      ¿Prefieres contactarnos directamente? <NavLink href={PHONES.main.href}>{PHONES.main.formatted}</NavLink> · <NavLink
        href={EMAIL.href}>{EMAIL.address}</NavLink
      >
    </p>
  </section>
  <ContactSection />
</Layout>
