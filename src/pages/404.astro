---
import Layout from "@/layouts/Layout.astro"
import PageSEO from "@/components/seo/PageSEO.astro"
import SectionHeader from "@/components/molecules/SectionHeader.astro"
import NavLink from "@/components/atoms/NavLink.astro"
import { Button } from "@/components/atoms/Button"
---

<Layout lang="es">
  <PageSEO
    currentPage="404"
    title="Página no encontrada"
    description="La página que buscas no existe. Vuelve al inicio o contáctanos y te ayudamos."
    slot="seo"
  />
  <section aria-labelledby="not-found-heading" class="flex flex-1 items-center justify-center px-gutter py-xl">
    <div class="mx-auto flex w-full max-w-5xl flex-col items-center gap-md text-center">
      <p aria-hidden="true" class="bg-gradient-to-br from-brand-pink to-primary bg-clip-text text-massive text-transparent">404</p>
      <SectionHeader
        align="center"
        level="h1"
        id="not-found-heading"
        eyebrow="Error 404"
        title="Página no encontrada"
        subtitle="La página que buscas no existe o cambió de dirección. Vuelve al inicio o contáctanos y te ayudamos."
        subtitleClass="mx-auto mt-md max-w-2xl font-body-lg text-body-lg text-on-surface-variant"
      />
      <div class="mt-lg flex flex-wrap justify-center gap-md">
        <Button variant="primary" size="md" href="/">Volver al inicio</Button>
        <Button variant="secondary" size="md" href="/contact">Contacto</Button>
      </div>
      <nav class="mt-md flex justify-center gap-4" aria-label="Mapa del sitio">
        <NavLink href="/">Inicio</NavLink>
        <NavLink href="/about">Nosotros</NavLink>
        <NavLink href="/contact">Contacto</NavLink>
      </nav>
    </div>
  </section>
</Layout>
