---
import Layout from "@/layouts/Layout.astro"
import PageSEO from "@/components/seo/PageSEO.astro"
---

<Layout>
  <PageSEO currentPage="404" title="Page not found" slot="seo" />
  <section class="mx-auto max-w-5xl px-4 py-16 text-center">
    <h1>Page not found</h1>
    <p class="mt-4">The page you are looking for does not exist.</p>
    <nav class="mt-6 flex justify-center gap-4" aria-label="Sitemap">
      <a href="/">Home</a>
      <a href="/about">About</a>
      <a href="/contact">Contact</a>
    </nav>
  </section>
</Layout>
